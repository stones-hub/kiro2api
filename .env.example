# ============================================================================
# kiro2api 环境配置文件示例（本机 Docker Compose / 管理模式）
# ============================================================================
# 复制此文件为 .env 并根据需要修改配置。
# 默认使用管理模式（KIRO_ADMIN_DATA_DIR），账号池为空，通过管理页面添加账号，
# 账号数据持久化在 ./data 目录（由 docker-compose.yml 挂载），不写入真实凭据到本文件。

# ============================================================================
# 两个独立密钥（必需，不得使用弱默认值）
# ============================================================================
#
# KIRO_CLIENT_TOKEN: 客户端调用 /v1/* 接口使用的认证密钥（Authorization: Bearer <token>）。
#   建议使用随机字符串，例如: openssl rand -hex 32
KIRO_CLIENT_TOKEN=

# KIRO_ADMIN_SECRET: 管理页面使用的独立密钥（X-Kiro-Admin-Token 请求头），
#   管理端口（容器内 8081）上的所有路由都需要这个头，包括页面本身（/）、
#   静态资源（/assets/*）、/api/* 管理接口，以及 /healthz；没有这个头一律 401。
#   必须与 KIRO_CLIENT_TOKEN 不同，且长度 >= 32 字符。建议: openssl rand -hex 32
KIRO_ADMIN_SECRET=

# KIRO_ADMIN_ORIGINS: 允许访问管理页面的来源（逗号分隔，仅 https 或 127.0.0.1/localhost 的 http）
#   值必须与浏览器地址栏里的来源完全一致：协议 + 主机 + 端口三者都要对得上。
#   例如通过 SSH 隧道把远程端口转发到本地 19003 访问，就要填 http://127.0.0.1:19003，
#   填 http://127.0.0.1:18081 或 http://localhost:19003 都算不同来源。
#   docker-compose.yml 默认值: http://127.0.0.1:18081
# KIRO_ADMIN_ORIGINS=http://127.0.0.1:18081

# ============================================================================
# Token管理配置（可选，管理模式下留空即可，账号池为空也能启动）
# ============================================================================
#
# 管理模式下账号池数据保存在 KIRO_ADMIN_DATA_DIR（容器内固定为 /app/data），
# 可通过管理页面添加/管理账号；也可以在首次启动前通过 KIRO_AUTH_TOKEN 预置账号
# （仅在 /app/data/accounts.json 不存在时生效，之后以管理页面数据为准）。
#
# 默认（本 docker-compose.yml）只支持两种取值：
#   - 空字符串（推荐，账号池为空，启动后用管理页面添加）
#   - 直接写 JSON 字符串：
#     KIRO_AUTH_TOKEN='[{"auth":"Social","refreshToken":"your_social_refresh_token_here"}]'
#
# 如果要把 KIRO_AUTH_TOKEN 设置为"容器内文件路径"（例如 /path/to/auth_config.json），
# 代码会先尝试把它当文件读取：该路径必须在容器里真实存在，而 docker-compose.yml
# 目前只挂载了 ./data:/app/data，并不会自动挂载任意主机路径；
# 若要用文件路径方式，需要自行在 docker-compose.yml 的 volumes 里额外加一条挂载
# （本任务未新增此挂载，不要只改这里就以为生效）。
#
# 每个认证配置对象包含：
# - auth: 认证方式，可选值为 "Social" 或 "IdC"
# - refreshToken: 刷新令牌（必需）
# - clientId: IdC认证的客户端ID（IdC认证时必需）
# - clientSecret: IdC认证的客户端密钥（IdC认证时必需）
# - disabled: 是否禁用此配置（可选，默认false）
#
# Token获取方式：
# - Social tokens: 通常位于 ~/.aws/sso/cache/ 目录下的JSON文件中
# - IdC tokens: 位于 ~/.aws/sso/cache/ 目录下的JSON文件中，需同时提供 clientId 和 clientSecret
#
# Token选择策略：
# - 系统使用"顺序选择"策略（sequential）
# - 按配置顺序依次使用token，当前token耗尽后自动切换到下一个
KIRO_AUTH_TOKEN=

# ============================================================================
# 基础服务配置
# ============================================================================

# 服务端口（docker-compose.yml 中容器内固定为 8080，此处仅用于非容器运行）
PORT=8080

# Gin运行模式: debug, release, test（默认: release）
GIN_MODE=release

# ============================================================================
# 日志配置
# ============================================================================

# 日志级别: debug, info, warn, error（默认: info）
LOG_LEVEL=info

# 日志格式: text, json（默认: json）
LOG_FORMAT=json

# 日志文件路径（可选，不设置则只输出到控制台）
# LOG_FILE=/var/log/kiro2api.log

# 控制台输出开关（默认: true）
# LOG_CONSOLE=true

# ============================================================================
# 工具配置
# ============================================================================

# 工具描述的最大长度（字符数，默认: 10000）
# 用于限制 tool description 字段的长度，防止超长内容导致上游API错误
# MAX_TOOL_DESCRIPTION_LENGTH=10000

# ============================================================================
# 本地缓存折算（可选，默认全部关闭）
# ============================================================================
#
# ⚠️ 这是 kiro2api 在本地做的"计费折算"，不是上游的真实缓存计量：
#    命中后把一部分 input token 记成 cache_read，让下游（如 NewAPI）按缓存价计费。
#    上游实际怎么计费不受这些配置影响。
#
# ⚠️ 空值会导致启动失败：下面这些变量要么整行不写（用默认值），要么写合法值。
#    例如写成 `KIRO_LOCAL_CACHE_MAX_PERCENT=` 进程会直接退出。
#    docker-compose.yml 用 env_file 把本文件的全部变量传进容器，
#    所以在这里写空值同样会让容器起不来。
#
# 命中条件（三者同时满足）：
#   - 距上一次相同请求在 5 分钟内；
#   - 同一个 API Key（若请求带 metadata.user_id，则还要同一个 user_id）；
#   - 请求前缀与上一次重复（system、历史消息等开头部分相同）。
# 所以首次请求永远不会显示缓存，续接对话从第二轮起才可能命中。

# 总开关：只有显式写 true 才启用，其他任何值（含不写）都是关闭
# KIRO_LOCAL_CACHE_DISCOUNT=true

# 命中后最多把 input token 的百分之几记成缓存读取（整数 0-100，默认: 40）
# KIRO_LOCAL_CACHE_MAX_PERCENT=40

# 命中后是否按固定百分比折算（只能是 true 或 false，默认: true）
#   true  = 命中就按 KIRO_LOCAL_CACHE_MAX_PERCENT 的固定比例折算，与实际匹配长度无关
#   false = 按实际匹配到的前缀长度折算，并以上面的百分比为上限
# KIRO_LOCAL_CACHE_FIXED_PERCENT_ON_HIT=true

# 折算后至少保留多少个未缓存 token（整数 >=0，默认: 0）
# KIRO_LOCAL_CACHE_MIN_UNCACHED_TOKENS=0

# ============================================================================
# 账号粘滞（可选）
# ============================================================================
#
# KIRO_STICKY_WAIT_SECONDS: 续接对话时，等待上一轮那个账号空闲的秒数（整数 0-60，默认: 10）。
#   上游的 prompt cache 是按账号隔离的，换账号会让下一轮的消耗大致翻倍，
#   所以这里宁可短暂排队等原账号。写 0 表示不等待，直接换账号。
#   ⚠️ 空值或非法值（非整数、负数、大于 60）会让进程启动失败退出。
# KIRO_STICKY_WAIT_SECONDS=10

# ============================================================================
# 最佳实践
# ============================================================================
#
# 1. 生产环境配置：
#    - 使用 GIN_MODE=release
#    - 配置多个token实现负载均衡
#    - 设置 LOG_LEVEL=info 或 warn
#    - 启用日志文件记录: LOG_FILE=/var/log/kiro2api.log
#
# 2. 开发环境配置：
#    - 使用 GIN_MODE=debug
#    - 设置 LOG_LEVEL=debug
#    - 保持控制台输出: LOG_CONSOLE=true
#
# 3. 故障排除：
#    - 启用 LOG_LEVEL=debug 查看详细日志
#    - 检查token是否过期：查看日志中的"token刷新"相关信息
#    - 验证JSON格式：使用在线JSON验证器检查KIRO_AUTH_TOKEN格式
#    - 检查使用限制：日志会显示剩余可用次数
